# See README.md for setup steps and current implementation limits.
# These three legacy placeholders are not currently read by runtime code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRACTICE_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Required: use your own project ID in BOTH fields and matching dataset names.
# This version reads public website-content datasets without a read token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Reserved; a private dataset needs code changes, not just this token.
SANITY_API_READ_TOKEN=
# Local seeding only when needed. Not required on the public Vercel website.
SANITY_API_WRITE_TOKEN=
# Generate a unique random secret; set the webhook's x-revalidate-secret header.
SANITY_REVALIDATE_SECRET=

# Resend confirmation emails only; OTP/login is not implemented in this copy.
# Keep the API key server-side. Use a sender domain YOU have verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Sutton Vet <registrations@mail.thesuttonvet.co.uk>"
RESEND_REPLY_TO=info@thesuttonvet.co.uk

# Lupa PMS API. Keep the API key server-side only. Never prefix it with NEXT_PUBLIC.
# Leave credentials blank for local/preview use unless live testing is approved.
# A sandbox dashboard does not imply dev API access; confirm the endpoint with Lupa.
LUPA_API_BASE_URL=https://api.lupapets.com/api/external
LUPA_API_KEY=
LUPA_COMPANY_ID=
LUPA_STORE_ID=
LUPA_DIAGNOSTICS_KEY=
LUPA_PAY_ENABLED=false
LUPA_HEALTH_PLAN_ENABLED=false

# Optional approved public URLs, not API endpoints. Check CMS links and routing;
# these values do not implement a hosted embed by themselves.
NEXT_PUBLIC_LUPA_BOOKING_URL=
NEXT_PUBLIC_LUPA_REGISTRATION_URL=
NEXT_PUBLIC_LUPA_HEALTHPLAN_URL=
NEXT_PUBLIC_LUPA_CLIENT_PORTAL_URL=

# Legacy PMS URL fallbacks. Prefer NEXT_PUBLIC_LUPA_* above for this project.
NEXT_PUBLIC_PMS_BOOKING_URL=
NEXT_PUBLIC_PMS_REGISTRATION_URL=
NEXT_PUBLIC_PMS_HEALTH_PLAN_URL=
